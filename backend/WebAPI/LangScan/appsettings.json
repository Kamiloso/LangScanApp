{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=db;Port=5432;Database=langscan;Username=langscan;"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8080"
      }
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "MaxRetryCount": 4,
    "MaxRetryDelayMs": 5000
  },
  "SnakeBrain": {
    "HttpAddress": "http://snakebrain:8080",
    "TimeoutMs": 30000
  },
  "AppConfig": {
    "RepetitionCycle": "24:00:00"
  }
}
